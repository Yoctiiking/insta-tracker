# Copie ce fichier en ".env" et remplis tes vraies infos.
# Ne commit JAMAIS le fichier ".env" (il est déjà dans .gitignore).

IG_USERNAME=ton_pseudo_instagram
IG_PASSWORD=ton_mot_de_passe

# Nombre max d'actions (unfollow) autorisées par exécution du script.
# Sécurité anti-détection de bot : Instagram surveille les pics d'activité.
MAX_ACTIONS_PER_RUN=15

# Délai (en secondes) entre deux actions consécutives
ACTION_DELAY_SECONDS=8
